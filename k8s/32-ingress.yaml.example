# Optional — only needed if you're routing through an Ingress controller
# (nginx-ingress, Traefik, etc.) with a real hostname instead of exposing
# the frontend Service directly via LoadBalancer/NodePort.
#
# If you use this: rename to 32-ingress.yaml, set frontend's Service type
# back to ClusterIP in 31-frontend-service.yaml, replace matterly.example.com
# below (must match app.tenant.base-domain / TENANT_BASE_DOMAIN on the
# backend), and confirm your cluster actually has an ingress controller
# installed (this manifest alone does nothing without one).
#
# Wildcard host: every tenant is a subdomain of the same base domain (see
# TenantResolutionFilter) and shares these same two Deployments - a new
# tenant needs a DNS record pointing its subdomain here, not a new Ingress
# rule or a change to this file. nginx-ingress supports wildcard hosts
# natively; if your controller doesn't, list each tenant subdomain as its
# own additional `host` entry under the same single `backend` instead.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: matterly-ingress
  namespace: matterly
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "20m"
spec:
  ingressClassName: nginx
  rules:
    - host: "*.matterly.example.com"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend
                port:
                  number: 80
    # The bare base domain itself resolves to the "default" tenant (see
    # TenantResolutionFilter) - the pre-existing law_db data.
    - host: matterly.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend
                port:
                  number: 80

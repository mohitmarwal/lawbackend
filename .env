# Copy this file to .env and fill in real values before running
# `docker compose up`. Nothing here has a safe default for production —
# MYSQL_ROOT_PASSWORD and JWT_SECRET in particular must be changed.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=WiwJxRZj46X5yakTHtgIDPR1

# --- Backend / JWT ---
# A long random string. Anyone who has this can forge login tokens.
JWT_SECRET=MsQJvaJrU6i7E8/AksTxZjxi+QssalWB+g2/uQ4elgiPCdrSwam8boruaeGiYn2l

# --- Notifications (leave NOTIFICATIONS_ENABLED=false until these are real) ---

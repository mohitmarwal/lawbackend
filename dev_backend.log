Hibernate: 
    SELECT
        cd.office_file_number AS fileNo,
        cd.case_number AS regNo,
        CONCAT(pc.name, ' vs ', dc.name) AS parties,
        c.name AS court,
        cd.filing_date AS prevDate,
        cd.next_date AS nextDate 
    FROM
        case_details cd 
    LEFT JOIN
        court c 
            ON cd.court_id = c.id 
    LEFT JOIN
        client pc 
            ON cd.plaintiff_client_id = pc.id 
    LEFT JOIN
        client dc 
            ON cd.defendant_client_id = dc.id 
    WHERE
        DATE(cd.next_date) = ? 
